# ==============================================================================
# Kooking — Production & Staging Environment Variables Example (Phase 40)
# ==============================================================================
#
# NOTE: Kooking is engineered local-first and is 100% functional without external backends.
# Anonymous visitors can browse, scale recipes, check pantries, manage personal shopping
# lists, and follow Cooking Mode instructions entirely offline using IndexedDB / localStorage.
#
# When connecting to Supabase for cloud-backed authentication and cross-device sync:
# 1. Copy this file:
#      cp .env.example .env.local
# 2. Supply values from your Supabase Project Settings -> API.
#
# ZERO-TRUST RULES:
# - NEVER set SUPABASE_SERVICE_ROLE_KEY in client variables (never prefix with NEXT_PUBLIC_).
# - NEVER commit `.env.local`, `.env.production`, or real API credentials to Git.
# ==============================================================================

# Application Base URL (Canonical URL for OpenGraph metadata and auth redirects)
NEXT_PUBLIC_APP_URL=https://kooking.app

# Supabase Project URL (Client-safe, protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public API Key (Client-safe, subject to RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
