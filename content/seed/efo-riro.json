  "steps": [
    {
      "id": "efo-riro-s1",
      "order": 1,
      "instruction": "Pour boiling water over the chopped spinach in a sieve, then squeeze out as much water as you can.",
      "ingredientIds": ["spinach"],
      "ingredientQuantities": {
        "spinach": 800
      },
      "estimatedMinutes": 8,
      "cues": {
        "texture": "Squeezed until no more water drips out."
      },
      "safetyNote": "Let it cool a little before squeezing."
    },
    {
      "id": "efo-riro-s2",
      "order": 2,
      "instruction": "Pulse the tatashe, scotch bonnets and quartered onion in the blender until coarse — not smooth.",
      "ingredientIds": ["tatashe", "scotch", "onion-blend"],
      "ingredientQuantities": {
        "tatashe": 3,
        "scotch": 2,
        "onion-blend": 1
      },
      "estimatedMinutes": 2,
      "image": {
        "src": "/images/recipes/steps/efo-base.jpg",
        "alt": "Coarsely blended pepper and onion beside sliced leaves and cooked ponmo"
      }
    },
    {
      "id": "efo-riro-s3",
      "order": 3,
      "instruction": "Boil the pepper mix in a pot uncovered until most of its water has cooked off.",
      "ingredientIds": [],
      "heat": "medium-high",
      "timer": {
        "durationSeconds": 900,
        "label": "Reduce the pepper"
      },
      "cues": {
        "visual": "Thick and paste-like."
      }
    },
    {
      "id": "efo-riro-s4",
      "order": 4,
      "instruction": "Push the pepper aside or tip it into a bowl. Heat the palm oil for 2 minutes, then fry the sliced onion and iru.",
      "ingredientIds": ["palm-oil", "onion-slice", "iru"],
      "ingredientQuantities": {
        "palm-oil": 100,
        "onion-slice": 1,
        "iru": 2
      },
      "heat": "medium",
      "timer": {
        "durationSeconds": 120,
        "label": "Fry onion and iru"
      },
      "cues": {
        "aroma": "Savoury and pungent — that's the iru doing its job."
      },
      "safetyNote": "Don't let the palm oil smoke."
    },
    {
      "id": "efo-riro-s5",
      "order": 5,
      "instruction": "Stir in the reduced pepper, crayfish and stock cubes. Fry until the oil floats on top.",
      "ingredientIds": ["crayfish", "cubes"],
      "ingredientQuantities": {
        "crayfish": 2,
        "cubes": 2
      },
      "heat": "medium",
      "timer": {
        "durationSeconds": 600,
        "label": "Fry the sauce"
      },
      "cues": {
        "visual": "Oil separates and shines on top."
      }
    },
    {
      "id": "efo-riro-s6",
      "order": 6,
      "instruction": "Add the cooked beef, ponmo and smoked fish. Season with salt and simmer.",
      "ingredientIds": ["beef", "ponmo", "smoked-fish", "salt"],
      "ingredientQuantities": {
        "beef": 500,
        "ponmo": 200,
        "smoked-fish": 1,
        "salt": null
      },
      "heat": "low",
      "timer": {
        "durationSeconds": 300,
        "label": "Simmer with meat"
      }
    },
    {
      "id": "efo-riro-s7",
      "order": 7,
      "instruction": "Stir in the squeezed spinach and cook uncovered just until hot through.",
      "ingredientIds": ["spinach"],
      "ingredientQuantities": {
        "spinach": 800
      },
      "heat": "low",
      "timer": {
        "durationSeconds": 180,
        "label": "Cook the spinach"
      },
      "cues": {
